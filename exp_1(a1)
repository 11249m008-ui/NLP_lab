import nltk
from nltk.corpus import stopwords
from nltk.tokenize import word_tokenize

nltk.download('punkt')
nltk.download('stopwords')

text = "This is a Natural Language Processing Lab."

words = word_tokenize(text)
stop_words = set(stopwords.words('english'))

result = [word for word in words if word.lower() not in stop_words and word.isalnum()]

print(result)
